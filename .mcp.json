{
  "mcpServers": {
    "QuiverQuant MCP": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.quiverquant.com/",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer YOUR_API_KEY_HERE"
      }
    }
  }
}
